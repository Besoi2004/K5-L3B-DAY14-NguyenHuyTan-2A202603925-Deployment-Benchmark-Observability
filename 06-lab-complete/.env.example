# Mẫu biến môi trường — KHÔNG ghi secret thật ở đây.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret: tạo key ngẫu nhiên, vd  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Docker Compose ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
